package templates

import (
	"accounting/internal/database/db"
	"accounting/internal/models"
)

// AdjustmentsPage adalah halaman Jurnal Penyesuaian: daftar jurnal yang
// ditandai sebagai penyesuaian pada akhir periode.
templ AdjustmentsPage(shell Shell, company db.Company, view models.AdjustmentView) {
	@Layout(shell) {
		@pageHeader("Jurnal Penyesuaian", company.Name+" · "+view.RoundingLabel) {
			<a href={ companyPath(company.UrlKey, "/journals/new?adjusting=1") } class={ btnPrimary }>
				<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
				</svg>
				Buat Jurnal Penyesuaian
			</a>
			<a href={ companyPath(company.UrlKey, "/worksheet") } class={ btnSecondary }>Kertas Kerja</a>
		}
		<div class={ cardClass + " mt-6" }>
			<div class={ cardTitleClass }>Daftar Jurnal Penyesuaian</div>
			if len(view.Rows) == 0 {
				@emptyState("M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10", "Belum ada jurnal penyesuaian", "Jurnal penyesuaian dipakai untuk menyelaraskan saldo pada akhir periode, misalnya penyusutan, biaya terutang, atau pendapatan diterima dimuka.") {
				}
			} else {
				<div class="overflow-x-auto">
					<table class="w-full min-w-[720px] text-sm">
						<thead>
							<tr class="border-b border-line bg-panel/60">
								<th class={ thClass }>Tanggal</th>
								<th class={ thClass }>Referensi</th>
								<th class={ thClass }>Keterangan</th>
								<th class={ thClass + " text-right" }>Nilai</th>
								<th class={ thClass + " text-center" }>Aksi</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, j := range view.Rows {
								<tr class="transition-colors hover:bg-panel/60">
									<td class="num px-5 py-3 text-xs text-muted">{ j.DateLabel }</td>
									<td class="num px-5 py-3 font-medium text-ink">
										<a
											href={ companyPath(company.UrlKey, "/journals/"+models.FormatThousands(j.ID)) }
											class="hover:text-accent hover:underline"
										>
											{ j.Reference }
										</a>
									</td>
									<td class="px-5 py-3 text-label">{ j.Memo }</td>
									<td class="num px-5 py-3 text-right text-ink">{ view.Money(j.Amount) }</td>
									<td class="px-5 py-3 text-center">
										<a
											href={ companyPath(company.UrlKey, "/journals/"+models.FormatThousands(j.ID)) }
											class={ btnGhost }
										>
											Detail
										</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
		<p class="mt-6 text-xs leading-relaxed text-muted">
			Jurnal penyesuaian terpisah dari jurnal umum supaya kertas kerja bisa menampilkan kolom penyesuaian.
			Tandai jurnal sebagai penyesuaian lewat centang pada form jurnal.
		</p>
	}
}
