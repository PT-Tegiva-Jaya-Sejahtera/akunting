package templates

import (
	"strconv"

	"accounting/internal/database/db"
	"accounting/internal/models"
)

// statusClass memberi gaya badge sesuai status undangan.
func statusClass(status string) string {
	switch status {
	case "pending":
		return "inline-flex rounded-input bg-accent-wash px-2.5 py-1 text-xs font-medium text-accent"
	case "used":
		return "inline-flex rounded-input bg-ok/10 px-2.5 py-1 text-xs font-medium text-ok"
	default:
		return "inline-flex rounded-input bg-panel px-2.5 py-1 text-xs font-medium text-muted"
	}
}

// InvitationsPage menampilkan pembuatan link undangan + PIN (sekali tampil)
// dan riwayat undangan perusahaan (khusus owner).
templ InvitationsPage(shell Shell, company db.Company, views []models.InviteView, result *models.NewInviteResult, errMsg string) {
	@Layout(shell) {
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Undangan</h1>
				<div class="mt-1.5 text-sm text-muted">
					{ company.Name } · buat link undangan, bagikan beserta PIN-nya, lalu penerima
					langsung mendaftar sendiri.
				</div>
			</div>
		</div>
		if errMsg != "" {
			@errBox(errMsg)
		}
		<div class={ cardClass + " mt-8 px-5 py-5" }>
			<div class="text-sm font-semibold text-ink">Buat Link Undangan</div>
			<p class="mt-1 text-sm text-muted">
				Satu tombol membuat link otomatis beserta PIN verifikasi.
				PIN berlaku 5 menit sejak dibuat; bagikan keduanya ke penerima
				(mis. lewat WhatsApp). Tidak ada email yang dikirim.
			</p>
			<form
				method="post"
				action={ companyPath(company.UrlKey, "/invitations") }
				class="mt-4 flex flex-wrap items-end gap-4"
			>
				<div>
					<label class="mb-1.5 block text-sm font-medium text-ink" for="role">Peran penerima</label>
					<select
						id="role"
						name="role"
						class={ inputClass + " w-44" }
					>
						@roleOptions("staff")
					</select>
				</div>
				<button
					type="submit"
					class={ btnPrimary }
				>
					Buat Link Undangan
				</button>
			</form>
			if result != nil {
				<div class="mt-5 rounded-input border border-ok/25 bg-ok/5 px-4 py-4">
					<div class="flex items-center gap-2 text-sm font-medium text-ok">
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
						</svg>
						Undangan baru dibuat. Salin dan bagikan sekarang juga:
					</div>
					<div class="mt-3 flex flex-wrap items-center gap-2">
						<input
							type="text"
							readonly
							value={ result.Link }
							onclick="this.select()"
							class={ inputClass + " num min-w-0 flex-1 py-1.5 text-xs" }
						/>
						<button
							type="button"
							hx-on:click="navigator.clipboard.writeText(this.previousElementSibling.value); this.textContent='Tersalin'"
							class={ btnSecondary + " px-3 py-1.5 text-xs" }
						>
							Salin Link
						</button>
					</div>
					<div class="mt-2 flex flex-wrap items-center gap-2">
						<input
							type="text"
							readonly
							value={ result.PIN }
							onclick="this.select()"
							class={ inputClass + " num w-32 py-1.5 text-center text-base font-semibold tracking-widest" }
						/>
						<button
							type="button"
							hx-on:click="navigator.clipboard.writeText(this.previousElementSibling.value); this.textContent='Tersalin'"
							class={ btnSecondary + " px-3 py-1.5 text-xs" }
						>
							Salin PIN
						</button>
						<span class="text-xs text-muted">PIN berlaku 5 menit sejak dibuat.</span>
					</div>
				</div>
			}
		</div>
		<div class={ cardClass + " mt-6" }>
			<div class={ cardTitleClass }>Riwayat Undangan</div>
			if len(views) == 0 {
				@emptyState("M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916v-.243", "Belum ada undangan", "Buat link undangan pertama untuk menambah anggota ke pembukuan ini.") {
				}
			} else {
				<div class="overflow-x-auto">
					<table class="w-full min-w-[720px] text-sm">
						<thead>
							<tr class="border-b border-line bg-panel/60">
								<th class={ thClass }>Email Penerima</th>
								<th class={ thClass }>Peran</th>
								<th class={ thClass }>Status</th>
								<th class={ thClass }>Dibuat</th>
								<th class={ thClass }>Sisa Link</th>
								<th class={ thClass }>Sisa PIN</th>
								<th class={ thClass + " text-center" }>Aksi</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, v := range views {
								<tr class="transition-colors hover:bg-panel/60">
									<td class="px-4 py-3 text-ink">{ v.Email }</td>
									<td class="px-4 py-3 text-label">{ roleLabel(v.Role) }</td>
									<td class="px-4 py-3">
										<span class={ statusClass(v.Status) }>{ v.StatusLabel }</span>
									</td>
									<td class="px-4 py-3 text-xs text-muted">{ v.CreatedAgo }</td>
									<td class="num px-4 py-3 text-xs text-muted">{ v.ExpiresIn }</td>
									<td class="num px-4 py-3 text-xs text-muted">{ v.PinLeft }</td>
									<td class="px-4 py-3 text-center">
										if v.Cancelable {
											<form
												method="post"
												action={ companyPath(company.UrlKey, "/invitations/"+strconv.FormatInt(v.ID, 10)+"/cancel") }
												onsubmit="return confirm('Batalkan undangan ini? Token dan PIN langsung mati.')"
											>
												<button type="submit" class={ btnGhost + " hover:bg-danger/10 hover:text-danger" }>
													Batalkan
												</button>
											</form>
										} else {
											<span class="text-xs text-muted">-</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
