package templates

import (
	"strconv"

	"accounting/internal/database/db"
	"accounting/internal/models"
)

// subTypeOptions merender pilihan sub-jenis akun PSAK 1.
templ subTypeOptions(current string) {
	<option value="aset_lancar" selected?={ current == "aset_lancar" }>Aset Lancar</option>
	<option value="aset_tidak_lancar" selected?={ current == "aset_tidak_lancar" }>Aset Tidak Lancar</option>
	<option value="liabilitas_jangka_pendek" selected?={ current == "liabilitas_jangka_pendek" }>Liabilitas Jangka Pendek</option>
	<option value="liabilitas_jangka_panjang" selected?={ current == "liabilitas_jangka_panjang" }>Liabilitas Jangka Panjang</option>
	<option value="ekuitas" selected?={ current == "ekuitas" }>Ekuitas</option>
	<option value="pendapatan" selected?={ current == "pendapatan" }>Pendapatan</option>
	<option value="beban" selected?={ current == "beban" }>Beban</option>
}

// accountTypeOptions merender pilihan jenis akun.
templ accountTypeOptions(current db.AccountType) {
	<option value="asset" selected?={ current == db.AccountTypeAsset }>asset</option>
	<option value="liability" selected?={ current == db.AccountTypeLiability }>liability</option>
	<option value="equity" selected?={ current == db.AccountTypeEquity }>equity</option>
	<option value="revenue" selected?={ current == db.AccountTypeRevenue }>revenue</option>
	<option value="expense" selected?={ current == db.AccountTypeExpense }>expense</option>
}

// normalOptions merender pilihan saldo normal.
templ normalOptions(current db.NormalBalance) {
	<option value="debit" selected?={ current == db.NormalBalanceDebit }>debit</option>
	<option value="credit" selected?={ current == db.NormalBalanceCredit }>credit</option>
}

// systemRoleOptions merender pilihan peran sistem akun. Akun Saldo Laba
// dipakai sebagai tujuan jurnal penutup saat tutup buku periode.
templ systemRoleOptions(current string) {
	<option value="" selected?={ current == "" }>Akun biasa</option>
	<option value={ models.SystemRoleRetainedEarnings } selected?={ current == models.SystemRoleRetainedEarnings }>
		Saldo Laba (tutup buku)
	</option>
}

// AccountsPage adalah menu kelola akun dengan sub-jenis PSAK 1.
templ AccountsPage(shell Shell, company db.Company, accounts []db.Account, errMsg string) {
	@Layout(shell) {
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Daftar Akun</h1>
				<div class="mt-1.5 text-sm text-muted">
					{ company.Name } · sub-jenis akun menentukan posisi setiap akun di
					Laporan Posisi Keuangan (PSAK 1).
				</div>
			</div>
		</div>
		if errMsg != "" {
			@errBox(errMsg)
		}
		<div class={ cardClass + " mt-8 px-5 py-5" }>
			<div class="text-sm font-semibold text-ink">Tambah Akun</div>
			<form
				method="post"
				action={ companyPath(company.UrlKey, "/accounts") }
				class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-6"
			>
				<div>
					<label class="mb-1.5 block text-sm font-medium text-ink" for="code">Kode</label>
					<input id="code" name="code" required placeholder="1101" class={ inputClass + " num" }/>
				</div>
				<div class="lg:col-span-2">
					<label class="mb-1.5 block text-sm font-medium text-ink" for="name">Nama</label>
					<input id="name" name="name" required placeholder="Piutang Usaha" class={ inputClass }/>
				</div>
				<div>
					<label class="mb-1.5 block text-sm font-medium text-ink" for="account_type">Jenis</label>
					<select id="account_type" name="account_type" class={ inputClass }>
						@accountTypeOptions(db.AccountTypeAsset)
					</select>
				</div>
				<div>
					<label class="mb-1.5 block text-sm font-medium text-ink" for="sub_type">Sub-Jenis</label>
					<select id="sub_type" name="sub_type" class={ inputClass }>
						@subTypeOptions(models.SubCurrentAsset)
					</select>
				</div>
				<div>
					<label class="mb-1.5 block text-sm font-medium text-ink" for="normal_balance">Saldo Normal</label>
					<select id="normal_balance" name="normal_balance" class={ inputClass }>
						@normalOptions(db.NormalBalanceDebit)
					</select>
				</div>
				<div class="lg:col-span-2">
					<label class="mb-1.5 block text-sm font-medium text-ink" for="system_role">Peran Sistem</label>
					<select id="system_role" name="system_role" class={ inputClass }>
						@systemRoleOptions("")
					</select>
				</div>
				<div class="flex items-end lg:col-span-4">
					<button type="submit" class={ btnPrimary }>
						<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
						</svg>
						Simpan
					</button>
				</div>
			</form>
		</div>
		<div class={ cardClass + " mt-6" }>
			<div class={ cardTitleClass }>Akun ({ strconv.Itoa(len(accounts)) })</div>
			if len(accounts) == 0 {
				@emptyState("M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z", "Belum ada akun", "Chart of accounts masih kosong. Tambahkan akun pertama lewat form di atas.") {
				}
			} else {
				<div class="overflow-x-auto">
					<table class="w-full min-w-[880px] text-sm">
						<thead>
							<tr class="border-b border-line bg-panel/60">
								<th class={ thClass }>Kode</th>
								<th class={ thClass }>Nama</th>
								<th class={ thClass }>Jenis</th>
								<th class={ thClass }>Sub-Jenis (PSAK 1)</th>
								<th class={ thClass }>Saldo Normal</th>
								<th class={ thClass }>Aktif</th>
								<th class={ thClass + " text-center" }>Aksi</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, a := range accounts {
								<tr class="transition-colors hover:bg-panel/40">
									<td colspan="7" class="p-0">
										<form
											method="post"
											action={ companyPath(company.UrlKey, "/accounts/"+strconv.FormatInt(a.ID, 10)) }
											class="flex flex-wrap items-center gap-2 px-4 py-2"
										>
											<span class="num w-16 text-xs text-muted">{ a.Code }</span>
											<input
												name="name"
												value={ a.Name }
												class={ inputClass + " w-44 py-1.5" }
											/>
											<select name="account_type" class={ inputClass + " w-28 py-1.5" }>
												@accountTypeOptions(a.AccountType)
											</select>
											<select name="sub_type" class={ inputClass + " w-48 py-1.5" }>
												@subTypeOptions(a.SubType)
											</select>
											<select name="normal_balance" class={ inputClass + " w-28 py-1.5" }>
												@normalOptions(a.NormalBalance)
											</select>
											<select name="system_role" class={ inputClass + " w-52 py-1.5" }>
												@systemRoleOptions(a.SystemRole)
											</select>
											<label class="flex items-center gap-2 text-xs text-muted">
												<input type="checkbox" name="is_active" checked?={ a.IsActive } class="h-4 w-4 rounded border-line text-accent focus:ring-accent/20"/>
												aktif
											</label>
											<button type="submit" class={ btnSecondary + " px-3 py-1 text-xs" }>
												Simpan
											</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}
