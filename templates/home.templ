package templates

import (
	"strconv"
	"time"

	"accounting/internal/database/db"
	"accounting/internal/models"
)

// HomePage adalah pemilih perusahaan: kartu besar berisi ringkasan
// jumlah pengguna, aktivitas terakhir, dan posisi aset.
templ HomePage(shell Shell, companies []db.ListCompaniesForUserWithStatsRow, errMsg string) {
	@Layout(shell) {
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div class="min-w-0">
				<h1 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Pilih Pembukuan</h1>
				<div class="mt-1.5 text-sm text-muted">
					Pilih perusahaan yang akan dibuka. Setelah memilih, Anda dapat berpindah perusahaan
					lewat picker di sidebar kiri.
				</div>
			</div>
		</div>
		if errMsg != "" {
			<div class="mt-4 rounded-input border border-danger/40 bg-danger/5 px-5 py-3 text-sm text-danger">{ errMsg }</div>
		}
		// Empat kartu per baris pada layar lebar; kartu terakhir selalu
		// ditempati tombol "Tambah pembukuan baru".
		<div class="mt-8 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
			if len(companies) == 0 {
				<div class={ cardClass + " sm:col-span-2 xl:col-span-3" }>
					@emptyState("M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21", "Belum ada perusahaan", "Belum ada pembukuan yang terhubung ke akun Anda. Minta owner perusahaan mengundang Anda lewat tautan undangan.") {
					}
				</div>
			}
			for _, c := range companies {
				<a
					href={ templ.URL("/companies/" + c.UrlKey + "/dashboard") }
					class="group block rounded-card border border-line bg-white px-6 py-6 shadow-card transition-all hover:-translate-y-0.5 hover:border-accent-soft hover:shadow-raised"
				>
					<div class="flex items-start justify-between gap-4">
						<div class="min-w-0">
							<div class="line-clamp-2 text-lg font-semibold leading-snug tracking-tight text-ink group-hover:text-accent">{ c.Name }</div>
							<div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
								<span class="num text-xs">{ c.Slug }</span>
								<span>·</span>
								<span>Mata uang <span class="num text-xs">{ c.BaseCurrency }</span></span>
							</div>
						</div>
						<span class="shrink-0 rounded-input bg-accent-wash px-2.5 py-1 text-xs font-semibold text-accent">
							{ roleLabel(c.Role) }
						</span>
					</div>
					<div class="mt-5 space-y-2.5 border-t border-line pt-4">
						@homeStat("Posisi Aset", models.FormatRounded(models.NumericToCents(c.TotalAssets), c.RoundingUnit), true)
						@homeStat("Laba Bersih", models.FormatRounded(models.NumericToCents(c.NetIncome), c.RoundingUnit), true)
						@homeStat("Pengguna", strconv.FormatInt(c.UserCount, 10), false)
						<div class="flex items-baseline justify-between gap-3">
							<span class="text-xs text-muted">Aktivitas Terakhir</span>
							if c.LastActivity.Valid {
								<span class="text-[13px] text-ink">{ models.FormatTimeAgoID(c.LastActivity.Time, time.Now()) }</span>
							} else {
								<span class="text-[13px] text-muted">belum pernah</span>
							}
						</div>
						<div class="pt-1 text-[10px] text-muted">{ models.RoundingLabel(c.RoundingUnit) }</div>
					</div>
				</a>
			}
			@newCompanyCard(len(companies) == 0)
		</div>
	}
}

// homeStat adalah satu baris label dan nilai pada kartu pembukuan. Label di
// kiri dan nilai di kanan supaya angka panjang tidak meluber di kartu sempit.
templ homeStat(label string, value string, tebal bool) {
	<div class="flex items-baseline justify-between gap-3">
		<span class="text-xs text-muted">{ label }</span>
		if tebal {
			<span class="num text-base font-semibold text-ink">{ value }</span>
		} else {
			<span class="num text-sm font-medium text-ink">{ value }</span>
		}
	</div>
}

// newCompanyCard adalah kartu terakhir pada halaman pemilihan pembukuan untuk
// menambah pembukuan baru. Klik membuka form isian nama; pembuatnya menjadi
// owner perusahaan itu, jadi akun pertama hasil setup bisa langsung bekerja.
// Saat belum ada pembukuan sama sekali, kartunya lebih menonjol (aksen).
templ newCompanyCard(pertama bool) {
	<details class="js-menu relative group">
		<summary
			class={ "flex min-h-[220px] w-full cursor-pointer list-none flex-col items-center justify-center gap-3 rounded-card border-2 border-dashed px-6 py-8 text-center transition-all focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/20",
				bordered(pertama) }
			aria-label="Tambah pembukuan baru"
		>
			<span class={ "flex h-12 w-12 items-center justify-center rounded-full transition-colors group-hover:bg-accent group-hover:text-white",
				badge(pertama) }>
				<svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
				</svg>
			</span>
			<span class="text-sm font-semibold text-ink">Tambah pembukuan baru</span>
			if pertama {
				<span class="max-w-[240px] text-xs leading-relaxed text-muted">Anda belum punya pembukuan. Buat yang pertama, lalu undang rekan lewat Pengaturan perusahaan.</span>
			} else {
				<span class="max-w-[220px] text-xs leading-relaxed text-muted">Buat pembukuan perusahaan baru. Anda menjadi owner pembukuannya.</span>
			}
		</summary>
		<div class="absolute left-0 top-full z-20 mt-2 w-full rounded-card border border-line bg-white p-4 shadow-dropdown">
			<form method="post" action="/companies" class="space-y-3">
				<div>
					<label class="mb-1.5 block text-sm font-medium text-ink" for="new-company-name">Nama Perusahaan</label>
					<input id="new-company-name" name="name" required placeholder="mis. PT Tegiva Jaya Sejahtera" class={ inputClass }/>
				</div>
				<button type="submit" class={ btnPrimary + " w-full py-2" }>Buat Pembukuan</button>
			</form>
		</div>
	</details>
}

// bordered memilih gaya bingkai kartu tambah pembukuan.
func bordered(pertama bool) string {
	if pertama {
		return "border-accent/50 bg-accent-wash/60 hover:border-accent hover:bg-accent-wash"
	}
	return "border-line bg-white/60 hover:border-accent-soft hover:bg-accent-wash"
}

// badge memilih warna bulatan ikon kartu tambah pembukuan.
func badge(pertama bool) string {
	if pertama {
		return "bg-accent text-white"
	}
	return "bg-accent-wash text-accent"
}
