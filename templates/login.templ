package templates

// LoginPage adalah halaman login standalone: username + password saja.
// Daftar perusahaan baru muncul SETELAH login. Kartu dengan garis gradasi
// aksen di atasnya supaya terasa berkarakter, bukan kotak putih polos.
templ LoginPage(errorMsg string) {
	@authShell("Masuk", "Pembukuan multi-perusahaan", "") {
		<h1 class="text-xl font-semibold tracking-tight text-ink">Masuk</h1>
		<p class="mb-6 mt-1 text-sm text-muted">
			Masuk dengan username dan password Anda.
		</p>
		if errorMsg != "" {
			@errBox(errorMsg)
		}
		<form method="post" action="/login" class="space-y-4">
			<div>
				<label class="mb-1.5 block text-sm font-medium text-ink" for="username">Username</label>
				<input
					id="username"
					name="username"
					type="text"
					required
					autocomplete="username"
					placeholder="username Anda"
					class={ inputClass }
				/>
			</div>
			<div>
				<label class="mb-1.5 block text-sm font-medium text-ink" for="password">Password</label>
				<div class="relative">
					<input
						id="password"
						name="password"
						type="password"
						required
						autocomplete="current-password"
						placeholder="password Anda"
						class={ inputClass + " pr-11" }
					/>
					@eyeToggle()
				</div>
			</div>
			<button
				type="submit"
				class={ btnPrimary + " mt-1 w-full py-2.5" }
			>
				Masuk
			</button>
		</form>
		<p class="mt-5 flex items-center justify-center gap-1.5 text-center text-xs text-muted">
			<svg class="h-3.5 w-3.5 text-ok" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
			</svg>
			Tersambung lewat jaringan privat Tailscale
		</p>
	}
}
