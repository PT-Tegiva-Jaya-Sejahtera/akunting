package templates

import (
	"strconv"

	"accounting/internal/database/db"
	"accounting/internal/models"
)

// kpiCard adalah kartu angka besar di baris atas dashboard.
templ kpiCard(label string, value string, note string, accentClass string) {
	<div class={ cardClass + " px-5 py-4" }>
		<div class="text-xs font-medium uppercase tracking-wider text-muted">{ label }</div>
		<div class={ kpiValueClass(accentClass) }>{ value }</div>
		if note != "" {
			<div class="mt-1 text-xs text-muted">{ note }</div>
		}
	</div>
}

// moneyRow adalah satu baris nilai pada kartu dashboard.
templ moneyRow(label string, value string, strong bool) {
	<div class="flex items-baseline justify-between gap-3 py-1.5">
		<span class={ moneyRowLabelClass(strong) }>{ label }</span>
		<span class={ moneyRowValueClass(strong) }>{ value }</span>
	</div>
}

// lineChart merender grafik garis pendapatan (aksen) dan beban (merah) dengan
// sumbu X dan Y, penanda pada setiap titik koordinat, dan lapisan hover yang
// diaktifkan static/js/chart.js. Gambar memakai rasio tetap sehingga selalu
// mengisi penuh lebar kartu tanpa distorsi pada layar selebar apa pun.
templ lineChart(c models.ChartData) {
	<div class="w-full">
		<div class="min-w-0">
			<div class="js-chart relative aspect-[10/3] w-full" data-chart="line">
				<svg viewBox={ "0 0 " + c.Width + " " + c.Height } class="h-full w-full" role="img">
					for _, g := range c.Grid {
						<line x1={ c.AxisX } x2={ c.AxisEnd } y1={ g.Y } y2={ g.Y } stroke="#e3ebf3" stroke-width="1"/>
						<text x={ g.X } y={ g.Y } text-anchor="end" dominant-baseline="middle" font-size="17" fill="#5b6b83">{ g.Label }</text>
					}
					<path d={ c.AreaG } fill="rgba(83,58,253,0.07)" stroke="none"/>
					<path d={ c.ExpPath } fill="none" stroke="#b01e48" stroke-width="2"/>
					<path d={ c.RevPath } fill="none" stroke="#533afd" stroke-width="2"/>
					<line x1={ c.AxisX } x2={ c.AxisX } y1="0" y2={ c.AxisY } stroke="#c9d6e4" stroke-width="1"/>
					<line x1={ c.AxisX } x2={ c.AxisEnd } y1={ c.AxisY } y2={ c.AxisY } stroke="#c9d6e4" stroke-width="1"/>
					<g class="js-chart-guide hidden">
						<line class="js-guide-line" x1="0" x2="0" y1="0" y2={ c.AxisY } stroke="#94a3b8" stroke-width="1" stroke-dasharray="3 3"/>
					</g>
					for _, p := range c.Points {
						<circle cx={ p.X } cy={ p.YRev } r="3" fill="#533afd"/>
						<circle cx={ p.X } cy={ p.YExp } r="3" fill="#b01e48"/>
					}
					for _, p := range c.Points {
						<circle class="js-chart-dot opacity-0" data-dot={ strconv.Itoa(p.Index) } cx={ p.X } cy={ p.YRev } r="5" fill="#533afd" stroke="#ffffff" stroke-width="2"/>
						<circle class="js-chart-dot opacity-0" data-dot={ strconv.Itoa(p.Index) } cx={ p.X } cy={ p.YExp } r="5" fill="#b01e48" stroke="#ffffff" stroke-width="2"/>
					}
					for _, p := range c.Points {
						<rect
							class="js-chart-hit"
							x={ p.BandX }
							y="0"
							width={ p.BandW }
							height={ c.Height }
							fill="transparent"
							data-index={ strconv.Itoa(p.Index) }
							data-x={ p.X }
							data-y={ p.YTop }
							data-label={ p.Label }
							data-rev={ p.RevText }
							data-exp={ p.ExpText }
							data-net={ p.NetText }
						/>
					}
				</svg>
			</div>
		</div>
	</div>
}

// barChart merender grafik batang laba bersih per keranjang seri dengan sumbu
// X dan Y, garis bantu beserta label nilainya, dan pita hover per batang.
templ barChart(c models.ChartData) {
	<div class="w-full">
		<div class="min-w-0">
			<div class="js-chart relative aspect-[5/1] w-full" data-chart="bar">
				<svg viewBox={ "0 0 " + c.Width + " " + c.Height } class="h-full w-full" role="img">
					for _, g := range c.Grid {
						<line x1={ c.AxisX } x2={ c.AxisEnd } y1={ g.Y } y2={ g.Y } stroke="#e3ebf3" stroke-width="1"/>
						<text x={ g.X } y={ g.Y } text-anchor="end" dominant-baseline="middle" font-size="17" fill="#5b6b83">{ g.Label }</text>
					}
					<line x1={ c.AxisX } x2={ c.AxisEnd } y1={ c.ZeroY } y2={ c.ZeroY } stroke="#c9d6e4" stroke-width="1"/>
					for _, b := range c.Bars {
						if b.Positive {
							<rect x={ b.X } y={ b.Y } width={ b.W } height={ b.H } rx="3" fill="rgba(15,122,53,0.55)">
								<title>{ b.Title }</title>
							</rect>
						} else {
							<rect x={ b.X } y={ b.Y } width={ b.W } height={ b.H } rx="3" fill="rgba(176,30,72,0.55)">
								<title>{ b.Title }</title>
							</rect>
						}
					}
					<line x1={ c.AxisX } x2={ c.AxisX } y1="0" y2={ c.AxisY } stroke="#c9d6e4" stroke-width="1"/>
					for _, b := range c.Bars {
						<rect
							class="js-chart-hit"
							x={ b.X }
							y="0"
							width={ b.W }
							height={ c.Height }
							fill="transparent"
							data-index=""
							data-x={ b.X }
							data-y={ b.Y }
							data-label={ b.Label }
							data-rev=""
							data-exp=""
							data-net={ b.NetText }
						/>
					}
				</svg>
			</div>
		</div>
	</div>
}

// chartNote menampilkan keterangan skala grafik.
templ chartNote(c models.ChartData) {
	if c.ScaleNote != "" {
		<div class="mb-1 text-right text-[10px] text-muted">{ c.ScaleNote }</div>
	}
}

// chartAxis merender label bulan di bawah grafik. Bila bulan lebih dari
// delapan, label ditampilkan dua bulan sekali supaya tidak terpotong.
templ chartAxis(c models.ChartData) {
	<div class="mt-2 flex w-full justify-between pl-[8%] text-[10px] text-muted">
		for i, l := range c.XLabels {
			<span class="flex-1 whitespace-nowrap text-center">
				if c.LabelStep == 1 || i%c.LabelStep == 0 {
					{ l.Text }
				}
			</span>
		}
	</div>
}

// DashboardPage adalah dashboard keuangan perusahaan: ringkasan posisi
// keuangan, kinerja periode berjalan, rasio ringkas, grafik 12 bulan, dan
// jurnal terbaru.
templ DashboardPage(shell Shell, company db.Company, view models.DashboardView) {
	@Layout(shell) {
		@pageHeader("Dashboard", company.Name+" · periode "+(view.PeriodName)+" ("+view.PeriodStatus+"), posisi per "+view.AsOfLabel) {
			<a href={ companyPath(company.UrlKey, "/journals/new") } class={ btnPrimary }>
				<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
				</svg>
				Jurnal Baru
			</a>
			<a href={ companyPath(company.UrlKey, "/reports") } class={ btnSecondary }>Laporan Keuangan</a>
		}
		<div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
			@kpiCard("Jumlah Aset", view.Money(view.TotalAssets), formatSub("Kas & setara kas "+view.Money(view.CashTotal), view.RoundingLabel), "text-ink")
			@kpiCard("Liabilitas", view.Money(view.TotalLiabilities), "Termasuk utang bank "+view.Money(view.BankLoan), "text-ink")
			@kpiCard("Ekuitas", view.Money(view.TotalEquity+view.UnclosedProfit), "Modal disetor dan saldo laba", "text-ink")
			if view.NetIncome >= 0 {
				@kpiCard("Laba Periode Berjalan", view.Money(view.NetIncome), "Margin "+models.FormatFloat(view.MarginLaba(), 1)+"%", "text-ok")
			} else {
				@kpiCard("Rugi Periode Berjalan", view.Money(-view.NetIncome), "Margin "+models.FormatFloat(view.MarginLaba(), 1)+"%", "text-danger")
			}
		</div>
		<div class="mt-6 grid gap-6 xl:grid-cols-3">
			<div id="tren-card" class={ cardClass + " xl:col-span-2" }>
				<div class={ cardTitleClass }>
					<div class="flex flex-wrap items-center justify-between gap-3">
						<span>{ view.SeriesTitle }</span>
						<span class="flex items-center gap-4 text-xs font-normal text-muted">
							<span class="flex items-center gap-1.5">
								<span class="h-2 w-2 rounded-full bg-accent"></span> Pendapatan
							</span>
							<span class="flex items-center gap-1.5">
								<span class="h-2 w-2 rounded-full bg-danger"></span> Beban
							</span>
							<span>{ view.RoundingLabel }</span>
						</span>
					</div>
				</div>
				<div class="flex flex-wrap items-center justify-between gap-2 border-b border-line px-5 py-2.5">
					<span class="text-[11px] font-semibold uppercase tracking-wider text-muted">Rentang</span>
					<div class="flex items-center gap-0.5 rounded-input border border-line bg-panel/60 p-0.5">
						for _, o := range view.RangeOptions {
							<a
								href={ templ.URL("?range=" + o.Value) }
								hx-get={ "?range=" + o.Value }
								hx-target="#tren-card"
								hx-select="#tren-card"
								hx-swap="outerHTML"
								hx-push-url="true"
								class={ rangeBtnClass(o.Active) }
							>
								{ o.Label }
							</a>
						}
					</div>
				</div>
				<div class="pb-4 pt-3">
					if view.LineChart.HasData {
						<div class="px-5">
							@chartNote(view.LineChart)
						</div>
						<div class="px-3">
							@lineChart(view.LineChart)
						</div>
						<div class="px-3">
							@chartAxis(view.LineChart)
						</div>
						<p class="mt-2 px-5 text-[10px] text-muted">Arahkan kursor ke grafik untuk melihat angka tiap periode.</p>
					} else {
						@emptyState("M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z", "Belum ada mutasi pendapatan atau beban", "Grafik muncul setelah ada jurnal pada 12 bulan terakhir.") {
						}
					}
				</div>
			</div>
			<div class={ cardClass }>
				<div class={ cardTitleClass }>Laba (Rugi) Bulanan</div>
				<div class="px-5 py-4">
					if view.BarChart.HasData {
						@chartNote(view.BarChart)
						@barChart(view.BarChart)
						@chartAxis(view.BarChart)
					} else {
						<p class="py-8 text-center text-sm text-muted">Belum ada data.</p>
					}
					<div class="mt-4 border-t border-line pt-3">
						@moneyRow("Pendapatan periode", view.Money(view.Revenue), false)
						@moneyRow("Beban periode", view.Money(view.Expense), false)
						@moneyRow("Laba (rugi) periode", view.Money(view.NetIncome), true)
					</div>
				</div>
			</div>
		</div>
		<div class="mt-6 grid gap-6 xl:grid-cols-3">
			<div class={ cardClass }>
				<div class={ cardTitleClass }>Posisi Keuangan</div>
				<div class="px-5 py-4">
					<div class="text-[11px] font-semibold uppercase tracking-wider text-muted">Aset</div>
					@moneyRow("Aset lancar", view.Money(view.CurrentAssets), false)
					@moneyRow("Aset tidak lancar", view.Money(view.NonCurrentAssets), false)
					@moneyRow("Jumlah aset", view.Money(view.TotalAssets), true)
					<div class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-muted">Liabilitas</div>
					@moneyRow("Jangka pendek", view.Money(view.CurrentLiabilities), false)
					@moneyRow("Jangka panjang", view.Money(view.TotalLiabilities-view.CurrentLiabilities), false)
					@moneyRow("Jumlah liabilitas", view.Money(view.TotalLiabilities), true)
					<div class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-muted">Ekuitas</div>
					for _, line := range view.Modals {
						@moneyRow(line.Name, view.Money(line.AmountCents), false)
					}
					@moneyRow("Laba (rugi) belum ditutup", view.Money(view.UnclosedProfit), false)
					@moneyRow("Jumlah ekuitas", view.Money(view.TotalEquity+view.UnclosedProfit), true)
				</div>
			</div>
			<div class={ cardClass }>
				<div class={ cardTitleClass }>Kas, Piutang, dan Utang</div>
				<div class="px-5 py-4">
					<div class="text-[11px] font-semibold uppercase tracking-wider text-muted">Kas dan setara kas</div>
					if len(view.CashLines) == 0 {
						<p class="py-1 text-sm text-muted">Belum ada akun kas atau bank.</p>
					} else {
						for _, line := range view.CashLines {
							@moneyRow(line.Name, view.Money(line.AmountCents), false)
						}
					}
					@moneyRow("Jumlah kas dan setara kas", view.Money(view.CashTotal), true)
					<div class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-muted">Piutang</div>
					if len(view.ReceivableLines) == 0 {
						<p class="py-1 text-sm text-muted">Belum ada akun piutang.</p>
					} else {
						for _, line := range view.ReceivableLines {
							@moneyRow(line.Name, view.Money(line.AmountCents), false)
						}
					}
					@moneyRow("Jumlah piutang", view.Money(view.ReceivableTotal), true)
					<div class="mt-3 text-[11px] font-semibold uppercase tracking-wider text-muted">Utang</div>
					for _, line := range view.PayableLines {
						@moneyRow(line.Name, view.Money(line.AmountCents), false)
					}
					@moneyRow("Utang pajak", view.Money(view.TaxPayable), false)
					@moneyRow("Utang bank", view.Money(view.BankLoan), false)
					@moneyRow("Jumlah utang", view.Money(models.SumLines(view.PayableLines)+view.TaxPayable+view.BankLoan), true)
				</div>
			</div>
			<div class={ cardClass }>
				<div class={ cardTitleClass }>Rasio dan Aktivitas</div>
				<div class="px-5 py-4">
					@ratioRow("Rasio lancar", models.FormatFloat(view.RatioLancar(), 2)+"x", "Aset lancar dibagi liabilitas jangka pendek")
					@ratioRow("DER", models.FormatFloat(view.RasioLiabilitasEkuitas(), 1)+"%", "Liabilitas dibagi ekuitas")
					@ratioRow("Margin laba", models.FormatFloat(view.MarginLaba(), 1)+"%", "Laba dibagi pendapatan periode")
					@ratioRow("Jumlah jurnal", strconv.FormatInt(view.JournalCount, 10)+" transaksi", "Seluruh periode tersimpan")
					@ratioRow("Periode berjalan", view.PeriodName, "Status "+view.PeriodStatus)
				</div>
			</div>
		</div>
		<div class={ cardClass + " mt-6" }>
			<div class={ cardTitleClass }>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<span>Jurnal Terbaru</span>
					<a href={ companyPath(company.UrlKey, "/journals") } class="text-xs font-medium text-accent hover:text-accent-hover hover:underline">Lihat semua jurnal</a>
				</div>
			</div>
			if len(view.Recent) == 0 {
				@emptyState("M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25", "Belum ada jurnal", "Catat transaksi pertama lewat tombol Jurnal Baru.") {
				}
			} else {
				<div class="overflow-x-auto">
					<table class="w-full min-w-[720px] text-sm">
						<thead>
							<tr class="border-b border-line bg-panel/60">
								<th class={ thClass }>Tanggal</th>
								<th class={ thClass }>Referensi</th>
								<th class={ thClass }>Keterangan</th>
								<th class={ thClass + " text-right" }>Nilai</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, j := range view.Recent {
								<tr class="transition-colors hover:bg-panel/60">
									<td class="num px-5 py-3 text-xs text-muted">{ j.DateLabel }</td>
									<td class="num px-5 py-3 font-medium text-ink">{ j.Reference }</td>
									<td class="px-5 py-3 text-label">{ j.Memo }</td>
									<td class="num px-5 py-3 text-right text-ink">{ view.Money(j.Amount) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	}
}

// ratioRow menampilkan satu rasio beserta keterangannya.
templ ratioRow(label string, value string, note string) {
	<div class="flex items-start justify-between gap-3 border-b border-line py-2.5 last:border-b-0">
		<div class="min-w-0">
			<div class="text-sm text-label">{ label }</div>
			<div class="mt-0.5 text-[11px] text-muted">{ note }</div>
		</div>
		<div class="num shrink-0 text-sm font-semibold text-ink">{ value }</div>
	</div>
}

// formatSub menggabungkan catatan kecil pada kartu KPI.
func formatSub(a string, b string) string {
	return a + " · " + b
}
