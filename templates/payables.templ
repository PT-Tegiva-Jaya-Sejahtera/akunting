package templates

import (
	"accounting/internal/database/db"
	"accounting/internal/models"
)

// payableCell merender satu sel angka aging (kosong bila nol) supaya
// tabel tetap ringan dan pola sel konsisten antar baris.
templ payableCell(view models.PayablesView, amount int64) {
	<td class="num px-5 py-2.5 text-right text-ink">
		if amount != 0 {
			{ view.Money(amount) }
		}
	</td>
}

// payableFootCell merender satu sel angka tfoot baris Jumlah (kosong bila
// nol) supaya formatnya konsisten dengan sel baris body di atasnya.
templ payableFootCell(view models.PayablesView, amount int64) {
	<td class="num px-5 py-2.5 text-right font-semibold text-ink">
		if amount != 0 {
			{ view.Money(amount) }
		}
	</td>
}

// PayablesPage adalah subledger hutang usaha: saldo terbuka per supplier
// dengan kolom aging, dihitung dari tanggal jatuh tempo vs tanggal laporan.
templ PayablesPage(shell Shell, company db.Company, view models.PayablesView) {
	@Layout(shell) {
		@pageHeader("Hutang Usaha", company.Name+" · per "+view.AsOfLabel) {
			<a href={ companyPath(company.UrlKey, "/reports/bs") } class={ btnSecondary }>Neraca</a>
		}
		<form method="get" class={ cardClass + " mt-6 flex flex-wrap items-end gap-4 px-5 py-4" }>
			@dateField("to", "to", "Tanggal laporan", view.AsOfISO)
			<button type="submit" class={ btnPrimary }>Tampilkan</button>
			<span class="text-xs text-muted">{ view.RoundingLabel }</span>
		</form>
		<div class={ cardClass + " mt-6" }>
			<div class={ cardTitleClass }>
				<div class="flex flex-wrap items-center justify-between gap-3">
					<span>Saldo Hutang per Supplier</span>
					<span class="text-xs font-normal text-muted">Umur hutang dihitung dari tanggal jatuh tempo</span>
				</div>
			</div>
			if len(view.Rows) == 0 {
				@emptyState("M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0z", "Belum ada hutang usaha", "Saldo hutang per supplier muncul setelah ada jurnal yang menyentuh akun hutang usaha.") {
				}
			} else {
				<div class="overflow-x-auto">
					<table class="w-full min-w-[960px] text-sm">
						<thead>
							<tr class="border-b border-line bg-panel/60">
								<th class={ thClass }>Supplier</th>
								<th class={ thClass + " text-right" }>Belum Jatuh Tempo</th>
								<th class={ thClass + " text-right" }>0-30 Hari</th>
								<th class={ thClass + " text-right" }>31-60 Hari</th>
								<th class={ thClass + " text-right" }>61-90 Hari</th>
								<th class={ thClass + " text-right" }>90+ Hari</th>
								<th class={ thClass + " text-right" }>Jumlah</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-line">
							for _, row := range view.Rows {
								<tr class="transition-colors hover:bg-panel/60">
									<td class="px-5 py-2.5 text-label">{ row.PartyName }</td>
									@payableCell(view, row.NotDue)
									@payableCell(view, row.Days030)
									@payableCell(view, row.Days3160)
									@payableCell(view, row.Days6190)
									@payableCell(view, row.Days90Plus)
									<td class="num px-5 py-2.5 text-right font-medium text-ink">{ view.Money(row.Total) }</td>
								</tr>
							}
						</tbody>
						<tfoot>
							<tr class="border-t-2 border-line bg-panel/60">
								<td class="px-5 py-2.5 text-sm font-semibold text-ink">Jumlah Hutang</td>
								@payableFootCell(view, view.Total.NotDue)
								@payableFootCell(view, view.Total.Days030)
								@payableFootCell(view, view.Total.Days3160)
								@payableFootCell(view, view.Total.Days6190)
								@payableFootCell(view, view.Total.Days90Plus)
								<td class="num px-5 py-2.5 text-right font-semibold text-ink">{ view.Money(view.Total.Total) }</td>
							</tr>
						</tfoot>
					</table>
				</div>
			}
		</div>
	}
}
